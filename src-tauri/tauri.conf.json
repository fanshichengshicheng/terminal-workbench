{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "终端工作台",
  "version": "0.2.8",
  "identifier": "com.personal.terminal-workbench",
  "build": {
    "beforeDevCommand": "pnpm desktop:prepare && pnpm desktop:web:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm desktop:prepare && pnpm desktop:web:build",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "终端工作台",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "backgroundColor": "#090b0d"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "resources": [
      "resources/codex.exe",
      "resources/codex-code-mode-host.exe",
      "resources/codex-command-runner.exe",
      "resources/codex-windows-sandbox-setup.exe"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
