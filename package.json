{
  "name": "terminal-workbench",
  "version": "0.2.7",
  "description": "A Windows project workbench with local Codex integration, canvas tools, plans, notes, and local launchers.",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "desktop:web:dev": "vite --config vite.desktop.config.ts --host 127.0.0.1 --port 1420",
    "desktop:web:build": "vite build --config vite.desktop.config.ts",
    "desktop:prepare": "node scripts/prepare-codex-sidecar.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern dist-desktop --ignore-pattern .next --ignore-pattern .vinext --ignore-pattern .wrangler --ignore-pattern src-tauri/target",
    "db:generate": "drizzle-kit generate",
    "codex:bridge": "node scripts/codex-bridge.mjs"
  },
  "dependencies": {
    "@openai/codex": "^0.147.0",
    "@tauri-apps/api": "^2.11.1",
    "@xyflow/react": "^12.11.2",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
